<configuration>

    <!--  [DEFAULT BEHAVIOR]
    profile: dev|stg|pre
    * console output in raw format (normal text, not json)
    * json output to relevant log file : api.log, backend.log, etc
    profile: non (dev|stg|pre), eg : perf, prod
    * console output nothing
    * json output to relevant log file : api.log, backend.log, etc
    -->

    <!-- ================================ -->
    <!-- Section : STDOUT & STDOUT JSON   -->
    <!-- ================================ -->

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProfile name="dev|stg|pre">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>[uniqueLogId=%X{uniqueLogId},parentId=%X{parentId}]${CONSOLE_LOG_PATTERN}</pattern>
                <charset>utf8</charset>
            </encoder>
        </appender>
    </springProfile>
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <arguments>
                </arguments>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>parentId</includeMdcKeyName>
                    <includeMdcKeyName>uniqueLogId</includeMdcKeyName>
                </mdc>
            </providers>
        </encoder>
    </appender>

    <!-- ======================= -->
    <!-- Section : API LOGGING   -->
    <!-- ======================= -->

    <property name="API_LOG_PATH" value="logs/api.log"/>
    <appender name="apiJsonAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${API_LOG_PATH}</file>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <arguments>
                </arguments>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <threadName/>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>parentId</includeMdcKeyName>
                    <includeMdcKeyName>uniqueLogId</includeMdcKeyName>
                </mdc>
            </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/api/api.%d{yyyy-MM-dd-HH}.%i.log</fileNamePattern>
            <maxFileSize>1GB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>30GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="apiLogger" additivity="false" level="INFO">
        <springProfile name="dev|stg|pre">
            <appender-ref ref="STDOUT_JSON"/>
        </springProfile>
        <appender-ref ref="apiJsonAppender"/>
    </logger>

    <!-- =========================== -->
    <!-- Section : BACKEND LOGGING   -->
    <!-- =========================== -->

    <property name="BACKEND_LOG_PATH" value="logs/backend.log"/>
    <appender name="backendJsonAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${BACKEND_LOG_PATH}</file>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <arguments>
                </arguments>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <threadName/>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>parentId</includeMdcKeyName>
                    <includeMdcKeyName>uniqueLogId</includeMdcKeyName>
                </mdc>
            </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/backend/backend.%d{yyyy-MM-dd-HH}.%i.log</fileNamePattern>
            <maxFileSize>1GB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>30GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="backendLogger" additivity="false" level="INFO">
        <springProfile name="dev|stg|pre">
            <appender-ref ref="STDOUT_JSON"/>
        </springProfile>
        <appender-ref ref="backendJsonAppender"/>
    </logger>

    <!-- ========================== -->
    <!-- Section : DETAIL LOGGING   -->
    <!-- ========================== -->

    <property name="DETAIL_LOG_PATH" value="logs/detail.log"/>
    <appender name="detailJsonAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${DETAIL_LOG_PATH}</file>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                    <timeZone>Asia/Tokyo</timeZone>
                </timestamp>
                <arguments>
                </arguments>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <threadName/>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>parentId</includeMdcKeyName>
                    <includeMdcKeyName>uniqueLogId</includeMdcKeyName>
                </mdc>
            </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/detail/detail.%d{yyyy-MM-dd-HH}.%i.log</fileNamePattern>
            <maxFileSize>1GB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>30GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <logger name="detailLogger" additivity="false" level="INFO">
        <springProfile name="dev|stg|pre">
            <appender-ref ref="STDOUT_JSON"/>
        </springProfile>
        <appender-ref ref="detailJsonAppender"/>
    </logger>

    <!-- ================================ -->
    <!-- Section : INFO & ERROR LOGGING   -->
    <!-- ================================ -->

    <property name="INFO_LOG_PATH" value="logs/info.log"/>
    <appender name="infoJsonAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${INFO_LOG_PATH}</file>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                    <timeZone>Asia/Tokyo</timeZone>
                </timestamp>
                <logLevel/>
                <arguments>
                </arguments>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <threadName/>
                <loggerName/>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>parentId</includeMdcKeyName>
                    <includeMdcKeyName>uniqueLogId</includeMdcKeyName>
                </mdc>
            </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/info/info.%d{yyyy-MM-dd-HH}.%i.log</fileNamePattern>
            <maxFileSize>1GB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>30GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <property name="ERROR_LOG_PATH" value="logs/error.log"/>
    <appender name="errorJsonAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ERROR_LOG_PATH}</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>@timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</pattern>
                    <timeZone>Asia/Tokyo</timeZone>
                </timestamp>
                <logLevel/>
                <arguments>
                </arguments>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <threadName/>
                <loggerName/>
                <mdc>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>parentId</includeMdcKeyName>
                    <includeMdcKeyName>uniqueLogId</includeMdcKeyName>
                </mdc>
                <stackTrace>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>20</shortenedClassNameLength>
                        <exclude>^sun\.reflect\..*\.invoke</exclude>
                        <exclude>^net\.sf\.cglib\.proxy\.MethodProxy\.invoke</exclude>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/error/error.%d{yyyy-MM-dd-HH}.%i.log</fileNamePattern>
            <maxFileSize>1GB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>30GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <springProfile name="dev|stg|pre">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>
    <root level="INFO">
        <appender-ref ref="infoJsonAppender"/>
        <appender-ref ref="errorJsonAppender"/>
    </root>
</configuration>
